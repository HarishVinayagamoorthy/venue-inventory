generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  holds        Hold[]
  properties   Property[]
}

model Property {
  id          String       @id @default(uuid())
  ownerId     String
  name        String
  city        String
  area        String
  address     String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id])
  spaces      VenueSpace[]

  @@index([ownerId], map: "Property_ownerId_fkey")
}

model VenueSpace {
  id          String      @id @default(uuid())
  propertyId  String
  name        String
  capacity    Int
  price       Decimal     @db.Decimal(10, 2)
  amenities   Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]
  property    Property    @relation(fields: [propertyId], references: [id])

  @@index([propertyId], map: "VenueSpace_propertyId_fkey")
}

model Inventory {
  id           String     @id @default(uuid())
  venueSpaceId String
  date         DateTime   @db.Date
  session      Session
  status       InvStatus  @default(AVAILABLE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookings     Booking[]
  holds        Hold[]
  venueSpace   VenueSpace @relation(fields: [venueSpaceId], references: [id])

  @@unique([venueSpaceId, date, session])
  @@index([date, session, status])
}

model Hold {
  id              String           @id @default(uuid())
  inventoryId     String
  customerId      String
  status          HoldStatus       @default(ACTIVE)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  booking         Booking?
  customer        User             @relation(fields: [customerId], references: [id])
  inventory       Inventory        @relation(fields: [inventoryId], references: [id])
  paymentAttempts PaymentAttempt[]

  @@index([status, expiresAt])
  @@index([customerId], map: "Hold_customerId_fkey")
  @@index([inventoryId], map: "Hold_inventoryId_fkey")
}

model PaymentAttempt {
  id             String        @id @default(uuid())
  holdId         String
  transactionId  String?       @unique
  idempotencyKey String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking?
  hold           Hold          @relation(fields: [holdId], references: [id])

  @@index([holdId], map: "PaymentAttempt_holdId_fkey")
}

model Booking {
  id               String         @id @default(uuid())
  inventoryId      String
  customerId       String
  holdId           String         @unique
  paymentAttemptId String         @unique
  bookingReference String         @unique
  amount           Decimal        @db.Decimal(10, 2)
  status           BookingStatus  @default(CONFIRMED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  customer         User           @relation(fields: [customerId], references: [id])
  hold             Hold           @relation(fields: [holdId], references: [id])
  inventory        Inventory      @relation(fields: [inventoryId], references: [id])
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])

  @@index([customerId], map: "Booking_customerId_fkey")
  @@index([inventoryId], map: "Booking_inventoryId_fkey")
}

enum Role {
  CUSTOMER
  PARTNER
  ADMIN
}

enum Session {
  MORNING
  EVENING
  FULL_DAY
}

enum InvStatus {
  AVAILABLE
  HOLD
  BOOKED
  BLOCKED
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}
